{
  "name": "@chronos/db",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:pull": "dotenv -e ../../.env -- drizzle-kit pull",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "devDependencies": {
    "@chronos/env": "workspace:*",
    "@chronos/typescript-config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-seed": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  }
}
